{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChronicleAnnotations",
  "description": "Schema for Chronicle semantic upgrades and document metadata",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark", "system"], "default": "light" },
        "hero_char": { "type": "string", "description": "Single character for hero hollow background circle" }
      },
      "required": ["title"]
    },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "epigraph",
              "section_break",
              "chat_box",
              "dual_column",
              "keyword",
              "coda"
            ]
          },
          "target": { "type": "string", "description": "Exact text or line identifier in Markdown to upgrade" },
          "line": { "type": "integer", "description": "1-based line number in source markdown if applicable" },
          "data": { "type": "object" }
        },
        "required": ["type"]
      }
    }
  },
  "required": ["meta"]
}
