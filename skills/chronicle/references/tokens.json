{
  "name": "Chronicle Design Tokens",
  "version": "1.0.0",
  "palette": {
    "light": {
      "base_surface": "#fbf9f6",
      "primary_ink": "#16181d",
      "secondary_ink": "#464e5f",
      "sole_accent": "#537791",
      "subtle_border": "rgba(22, 24, 29, 0.14)",
      "subtle_fill": "rgba(22, 24, 29, 0.04)",
      "stroke_tint": "rgba(22, 24, 29, 0.55)"
    },
    "dark": {
      "base_surface": "#121418",
      "primary_ink": "#e8ecf1",
      "secondary_ink": "#a3abb8",
      "sole_accent": "#9cb4cd",
      "subtle_border": "rgba(232, 236, 241, 0.16)",
      "subtle_fill": "rgba(232, 236, 241, 0.05)",
      "stroke_tint": "rgba(232, 236, 241, 0.55)"
    },
    "resume": {
      "base_surface": "#ffffff",
      "primary_ink": "#111827",
      "secondary_ink": "#4b5563",
      "sole_accent": "#537791",
      "subtle_fill": "#f3f4f6",
      "line_height": 1.55
    }
  },
  "typography": {
    "families": {
      "body": "\"Noto Sans SC\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
      "heading": "\"Noto Serif SC\", \"Songti SC\", \"Source Han Serif SC\", SimSun, serif"
    },
    "weights": {
      "body": 300,
      "body_regular": 400,
      "body_medium": 500,
      "heading_semibold": 600,
      "heading_bold": 700
    },
    "scale": {
      "micro": { "size": "12px", "line_height": 1.33 },
      "auxiliary": { "size": "14px", "line_height": 1.42 },
      "body": { "size_min": "16px", "size_max": "18px", "line_height": 1.85 },
      "subheading": { "size_min": "20px", "size_max": "24px", "line_height_min": 1.33, "line_height_max": 1.4 },
      "major_heading": { "size_min": "28px", "size_max": "40px", "line_height_min": 1.1, "line_height_max": 1.2 },
      "giant_display": { "size_min": "48px", "size_max": "128px", "line_height": 1.0 }
    },
    "paragraph_gap_ratio": 1.75
  },
  "layout": {
    "horizontal_safe_padding": "24px",
    "reading_max_width": "896px",
    "dialogue_max_width": "608px",
    "dual_column_max_width": "384px",
    "terminal_overscroll": {
      "mobile": "96px",
      "desktop": "160px"
    }
  },
  "hard_constraints": [
    "Alignment Contamination: All body text must be Left-Aligned (NO Justify).",
    "Chromatic Contamination: Sole Accent is the ONLY color allowed. No red/green/yellow.",
    "Body Weight Lockdown: Narrative paragraphs must be 300 Light or 400 Regular.",
    "Line-Height Collapse: Body line-height ratio must never drop below 1.80 (Page), 1.75 (Slides), or 1.50 (Resume).",
    "Shadow Abuse: Content containers in reading flow must never use drop shadows.",
    "Visual Field Ceiling: Reading text max-width 896px, min 24px safe padding.",
    "CJK Formatting: Space must separate CJK and Latin characters/numerals."
  ]
}
